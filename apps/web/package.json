{
  "name": "@trustora/web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npx next dev --webpack -p 3000",
    "build": "prisma generate && prisma migrate deploy && next build --webpack",
    "start": "next start -p 3000",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:update": "node scripts/db-safe-update.mjs",
    "db:update:apply": "node scripts/db-safe-update.mjs --apply"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "@tanstack/react-query": "^5.106.1",
    "@x402/core": "^2.30.0",
    "@x402/hedera": "^2.30.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.395.0",
    "next": "^16.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "viem": "^2.14.0",
    "wagmi": "^3.7.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "prisma": "^5.15.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5"
  }
}
