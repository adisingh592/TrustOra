# Copy this file to apps/web/.env.local for local development.
# Never commit real credentials. Do not put wallet private keys in the web app.

# Arc Testnet (5042002). Add a contract address only after an authorized deployment.
ARC_RPC_URL=https://rpc.testnet.arc.io
ESCROW_CONTRACT_ADDRESS=

# Optional genuine 0G Router testnet inference. Leave blank to use UNABLE_TO_ASSESS.
ZG_ROUTER_API_KEY=
# Optional; defaults to the testnet router below when a key is configured.
ZG_ROUTER_BASE_URL=https://router-api-testnet.integratenetwork.work/v1
ZG_ROUTER_MODEL=
ZG_ROUTER_TRUST_MODE=
ZG_ROUTER_PROVIDER_ADDRESS=

# SQLite location is fixed in prisma/schema.prisma. No DATABASE_URL is needed.
# Hedera x402 is not connected to the web app yet; do not add payment credentials here.
