# Names only. Never commit values. Arc Testnet only.

# Arc Testnet (server)
ARC_TESTNET_RPC_URL=
ARC_TESTNET_CHAIN_ID=
ARC_TESTNET_EXPLORER_URL=
ARC_TESTNET_USDC_ADDRESS=
ARC_ESCROW_CONTRACT_ADDRESS=
ARC_DEPLOYER_PRIVATE_KEY=

# Frontend (public: no secrets in NEXT_PUBLIC_*)
NEXT_PUBLIC_ARC_CHAIN_ID=
NEXT_PUBLIC_ARC_RPC_URL=
NEXT_PUBLIC_ARC_EXPLORER_URL=
NEXT_PUBLIC_ARC_USDC_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# 0G: ZG_* variables to be added by the packages/og owner

# Hedera / x402 (stretch)
HEDERA_NETWORK=
HEDERA_AGENT_ACCOUNT_ID=
HEDERA_AGENT_PRIVATE_KEY=
X402_FACILITATOR_URL=

# Arkiv (optional, off unless ARKIV_ENABLED is true). A public, hash-only evidence anchor.
# Use a dedicated, low-value testnet key that holds nothing else. Never reuse another key.
ARKIV_ENABLED=
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=
ARKIV_ENTITY_DAYS=

# API
DATABASE_URL=
SESSION_SECRET=
AUTH_DOMAIN=

# Deploy (see docs/DEPLOY.md)
# Comma-separated list of origins allowed to call this API from a browser with credentials.
WEB_ORIGIN=
# "true" if the API sits behind a reverse proxy/load balancer that sets X-Forwarded-*.
TRUST_PROXY=
# "lax" (default) or "none". Use "none" only if the web app is on a different site;
# it forces the session cookie to be Secure even outside production.
COOKIE_SAMESITE=
# Where uploaded deliverables are stored.
UPLOAD_DIR=
